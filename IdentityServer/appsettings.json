{
  "Logging": {
    "Console": {
      "IncludeScopes": true
    },
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "FrontendUrls": {
    "CreateProfile": "http://inno-clinic.portal.com/create-profile",
    "Error": "http://localhost:4000/error"
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Server=.\\MSSQLSERVER01;Database=Identity;Trusted_Connection=True;TrustServerCertificate=True;"
  },
  "CorsSettings": {
    "AllowedOrigins": [
      "http://inno-clinic.portal.com"
    ]
  },
  "IdentityConfiguration": {
    "Clients": [
      {
        "ClientId": "swagger_client",
        "ClientName": "Swagger UI",
        "GrantTypes": [ "Code" ],
        "RedirectUris": [ "http://localhost:5225" ],
        "AllowedCorsOrigins": [ "https://localhost:7196", "http://localhost:5225" ],
        "AllowedScopes": [
          "openid",
          "profile",
          "api_scope",
          "custom_profile"
        ]
      },
      {
        "ClientId": "react_client",
        "ClientName": "React Application",
        "GrantTypes": [ "ResourceOwnerPassword" ],
        "AllowOfflineAccess": true,
        "RedirectUris": [ "http://localhost:5173/callback" ],
        "AllowedCorsOrigins": [ "https://inno-clinic.portal.com", "http://inno-clinic.portal.com" ],
        "AllowedScopes": [ "openid", "profile", "api_scope", "email", "custom_profile" ]
      }
    ]
  }
}